          {
            "index": 1,
            "text": "यह तैयार ओक बाउल है, तेल लगाया गया और टेबल के लिए तैयार।"
          },
          {
            "index": 2,
            "text": "यह एक गिरे हुए पेड़ से निकले खुरदरे ब्लैंक से शुरू हुआ था।"
          },
          {
            "index": 3,
            "text": "यह कच्चा ओक ब्लैंक है, अभी भी गीला और भारी।"
          },
          {
            "index": 4,
            "text": "दाने मुझे बताते हैं कि बाउल कहाँ बनना चाहता है।"
          },
          {
            "index": 5,
            "text": "लेथ पर लंबी, स्थिर कटों में आकार उभरता है।"
          },
          {
            "index": 6,
            "text": "मैं किनारे से आधार तक दीवार की मोटाई समान रखता हूँ।"
          },
          {
            "index": 7,
            "text": "सैंडिंग मोटे से बारीक तक होती है, लेथ धीरे-धीरे घूमते हुए।"
          },
          {
            "index": 8,
            "text": "यहीं से दाने चमकने लगते हैं।"
          },
          {
            "index": 9,
            "text": "खाने के लिए सुरक्षित तेल की एक परत रंग को उभारती है।"
