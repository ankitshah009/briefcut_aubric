          {
            "index": 1,
            "text": "यह तैयार ओक बाउल है, तेल लगाया हुआ और खाने की मेज़ के लिए तैयार।"
          },
          {
            "index": 2,
            "text": "यह एक गिरे हुए पेड़ से निकले खुरदरे ब्लैंक से शुरू हुआ था।"
          },
          {
            "index": 3,
            "text": "यहाँ कच्चा ओक ब्लैंक है, अभी भी गीला और भारी।"
          },
          {
            "index": 4,
            "text": "लकड़ी की शिरा मुझे बताती है कि बाउल कहाँ बनना चाहता है।"
          },
          {
            "index": 5,
            "text": "लेथ पर लंबी, स्थिर कटों में आकार उभरता है।"
          },
          {
            "index": 6,
            "text": "मैं किनारे से तली तक दीवार की मोटाई एक समान रखता हूँ।"
          },
          {
            "index": 7,
            "text": "सैंडिंग मोटे से बारीक तक होती है, लेथ धीरे-धीरे घूमते हुए।"
          },
          {
            "index": 8,
            "text": "यहीं लकड़ी की शिरा चमकने लगती है।"
          },
          {
            "index": 9,
            "text": "खाने के लिए सुरक्षित तेल की एक परत रंग को उभार देती है।"
